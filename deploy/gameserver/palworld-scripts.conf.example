# =============================================================================
# palworld-scripts.conf - zentrale Konfiguration ALLER Gameserver-Skripte
# Variante fuer eine NATIVE Instanz (SteamCMD + systemd, ohne Docker)
# =============================================================================
# Ort: /etc/palworld/palworld-scripts.conf - dort liegen auch die Skripte.
# WICHTIG: chmod 600 - hier stehen AdminPassword, Webhook und Upload-Secret.
# Suchreihenfolge aller Skripte:
#   1. $PALWORLD_CONF   2. neben dem Skript   3. /etc/palworld/palworld-scripts.conf
#
# Werte mit [SERVER] sind pro Server verschieden - alles andere ist auf allen
# Gameservern gleich, damit Skripte und Cron identisch bleiben koennen.
# =============================================================================

# --- Der Spielserver selbst ---------------------------------------------------
SERVICE="palworld"                     # Name der systemd-Unit (ohne .service)
PAL_USER="palworld"                    # Benutzer, dem Server + SteamCMD gehoeren
INSTALL_DIR="/home/palworld/palserver" # Palworld-Installationsverzeichnis
STEAMCMD="/home/palworld/steamcmd/steamcmd.sh"
APP_ID=2394010                         # Steam-App-Id des Dedicated Servers
SAVED_DIR="/home/palworld/palserver/Pal/Saved"

# --- REST-API -----------------------------------------------------------------
ADMIN_PASSWORD="CHANGE_ME"             # [SERVER] = AdminPassword aus der INI
REST_PORT=8212                         # = RESTAPIPort
REST_HOST="127.0.0.1"                  # nativ: die API laeuft lokal

# --- Update / Neustart (palworld-autoupdate.sh) -------------------------------
WARN_MINUTES=(10 5)                    # Ingame-Vorwarnungen in Minuten
FINAL_COUNTDOWN=60                     # Sekunden bis zum Shutdown nach der Warnung
ALLOW_RESTART_WITHOUT_API=false        # true = notfalls ohne Warnung/Save
BACKUP_KEEP=10                         # Backups aus Update-Laeufen
BACKUP_ON_FORCE_RESTART=false

# --- Backups ------------------------------------------------------------------
BACKUP_DIR="/home/palworld/backups"    # BACKUP_DIR="" = Backups deaktivieren
LIVE_BACKUP_KEEP=12                    # 12 = 3 Tage bei 4 Laeufen pro Tag
LIVE_BACKUP_SAVE_WAIT=15
BACKUP_LOCK_WAIT=900

# --- Watchdog -----------------------------------------------------------------
WATCHDOG_FAILS_MAX=3
WATCHDOG_GRACE_SECONDS=300

# --- Ingame-Ansagen (palworld-announce.sh) ------------------------------------
#ANNOUNCE_FILE=""                      # Default: announcements.txt neben dem Skript
ANNOUNCE_ORDER="rotate"                # rotate = der Reihe nach | random
ANNOUNCE_ONLY_WITH_PLAYERS=true

# --- Discord ------------------------------------------------------------------
# Beide Server duerfen denselben Webhook/Kanal nutzen: jeder Host pflegt seine
# eigenen Nachrichten (Status + Neustarts), erkennbar am Namen.
DISCORD_WEBHOOK=""                             # [SERVER] (oder identisch)
DISCORD_SERVER_NAME="Server 1 · PvE 4x"        # [SERVER] Titel/--name
# Zeiten, zu denen der Server WIRKLICH runtergeht = Cron-Zeit + Vorwarnzeit.
# Cron "55 4,9,17" + 10 min Warnung -> "05:05 10:05 18:05"
RESTART_SCHEDULE="05:05 10:05 18:05"           # [SERVER]
# DISCORD_RESTART_MESSAGE=false                # zurueck zum Nachrichten-Spam
# DISCORD_ALERT_NEW_MESSAGE=true               # Fehler extra posten (Ping)
# DISCORD_STATE_FILE="/var/lib/palworld/discord-restart.json"

# --- Status-Nachricht (palworld-status.sh -> discord-status.py) ---------------
SERVER_ADDRESS="pve.palheim.de:8211"           # [SERVER] Join-Adresse
STATUS_API="http://127.0.0.1:8212"             # nativ: direkt lokal
# STATUS_STATE="/var/lib/palworld/discord-status.json"

# --- Python-Werkzeuge ---------------------------------------------------------
# Standard: .py-Dateien neben den Skripten, Interpreter aus dem venv.
# PALTOOLS_DIR="/etc/palworld"
# PALTOOLS_PYTHON="/opt/paltools/bin/python3"

# --- Uploads zur Webseite (palworld-upload.sh) --------------------------------
SAV_GLOB="/home/palworld/palserver/Pal/Saved/SaveGames/0/*/Level.sav"
UPLOAD_URL="https://palheim.de"                # Basis-URL der Webseite
UPLOAD_SECRET="CHANGE_ME"                      # uploadSecret aus der config.json
WEB_SERVER_ID="pve"                            # [SERVER] Server-ID der Webseite
